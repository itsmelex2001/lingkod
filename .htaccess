# Prevent directory browsing
Options -Indexes

# Deny access to all hidden files (like .env, .git, .gitignore)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to database scripts, archives, development executables and logs
<FilesMatch "\.(sql|bak|log|ini|zip|rar|tar|gz|exe|cs|ps1)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Specifically deny direct HTTP access to developer debug/test files in webroot
<FilesMatch "^(check-users|check_db|check_depts|dump_schema|run_sql|setup|test.*|test_.*|migrate_status|fix_.*)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/admin/(settings|faqs|system)(/.*)?$ api/admin-settings-router.php?route=/admin/$1$2 [QSA,L]
    RewriteRule ^api/admin/users(/.*)?$ api/admin-users-router.php?route=/admin/users$1 [QSA,L]
    RewriteRule ^api/public/chatbot-faqs$ api/admin-settings-router.php?route=/public/chatbot-faqs [QSA,L]
</IfModule>

